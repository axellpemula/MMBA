execute if block ~~~ light_block_5 run tag @s add _air_like
execute if block ~~~ light_block_6 run tag @s add _air_like
execute if block ~~~ light_block_7 run tag @s add _air_like
execute if block ~~~ light_block_8 run tag @s add _air_like
execute if block ~~~ light_block_9 run tag @s add _air_like
execute if block ~~~ light_block_10 run tag @s add _air_like
execute if block ~~~ light_block_11 run tag @s add _air_like
execute if block ~~~ light_block_12 run tag @s add _air_like
execute if block ~~~ light_block_13 run tag @s add _air_like
execute if block ~~~ light_block_14 run tag @s add _air_like
execute if block ~~~ light_block_15 run tag @s add _air_like
