{
  "format_version": "1.19.0",
  "animation_controllers": {
    "controller.animation.tusk_3": {
      "states": {
        "default": {
          "animations": [
            "tusk3_default"
          ],
          "transitions": [
            {
              "idle": "variable.stand_ui_preview"
            },
            {
              "summon": "variable.stand && !(v.tusk_reset_3 ?? 0)"
            }
          ],
          "blend_transition": 0.2,
          "blend_via_shortest_path": true
        },
        "summon": {
          "animations": [
            "tusk3_summon"
          ],
          "transitions": [
            {
              "default": "!variable.stand || (v.tusk_reset_3 ?? 0)"
            },
            {
              "idle": "q.all_animations_finished && q.ground_speed < 0.5"
            },
            {
              "walk": "q.all_animations_finished && q.ground_speed > 0.5 && (-math.sin(q.body_y_rotation) * query.movement_direction(0) + math.cos(q.body_y_rotation) * query.movement_direction(2)) > 0.5"
            }
          ],
          "blend_transition": 0.2,
          "blend_via_shortest_path": true
        },
        "idle": {
          "animations": [
            "tusk3_idle"
          ],
          "transitions": [
            {
              "default": "!variable.stand || (v.tusk_reset_3 ?? 0)"
            },
            {
              "walk": "q.ground_speed > 0.5 && (-math.sin(q.body_y_rotation) * query.movement_direction(0) + math.cos(q.body_y_rotation) * query.movement_direction(2)) > 0.5"
            }
          ],
          "blend_transition": 0.3,
          "blend_via_shortest_path": true
        },
        "walk": {
          "animations": [
            "tusk3_walk"
          ],
          "transitions": [
            {
              "default": "!variable.stand || (v.tusk_reset_3 ?? 0)"
            },
            {
              "idle": "(-math.sin(q.body_y_rotation) * query.movement_direction(0) + math.cos(q.body_y_rotation) * query.movement_direction(2)) <= 0.5"
            }
          ],
          "blend_transition": 0.3,
          "blend_via_shortest_path": true
        }
      }
    }
  }
}
