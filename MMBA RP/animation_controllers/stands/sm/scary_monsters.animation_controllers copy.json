{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.scary_monsters": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"scary_monsters_tail_default"
					],
					"transitions": [
						{
							"active": "!variable.is_paperdoll && (query.get_equipped_item_name(0) == 'stand' || query.get_equipped_item_name(0) == 'stand2')"
						}
					],
					"blend_transition": 0,
					"blend_via_shortest_path": true
				},
				"active": {
					"animations": [
						"scary_monsters_tail_main"
					],
					"transitions": [
						{
							"default": "!variable.is_paperdoll && query.get_equipped_item_name(0) != 'stand' && query.get_equipped_item_name(0) != 'stand2'"
						}
					],
					"blend_transition": 0,
					"blend_via_shortest_path": true
				}
			}
		}
	}
}