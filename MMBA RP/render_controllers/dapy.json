{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.xvoid": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.default" ]
    },
    "controller.render.wrecking_ball": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "query.property('property:wrecking') > 0 ? Texture.wrecking : Texture.default" ],
      "part_visibility": [
        { "*": true },
        { "SteelShell": "query.property('property:wrecking') == 0" },
        { "bone": "query.property('property:wrecking') == 0" },
        { "WreckingShell": "query.property('property:wrecking') == 1 || query.property('property:wrecking') == 2" },
        { "Sockets": "query.property('property:wrecking') == 1 || query.property('property:wrecking') == 2" },
        { "Satellites": "query.property('property:wrecking') == 1" },
        { "SingleSatellite": "query.property('property:wrecking') == 3" }
      ]
    }
  }
}
