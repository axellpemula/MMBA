        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightUpperArm": "query.property('property:tim_limb') == 1 || query.property('property:tim_limb') == 4"
