{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.civil_war": {
      "geometry": "Geometry.civil_war",
      "materials": [
        {
          "*": "Material.stand_color"
        }
      ],
      "textures": [
        "Texture.civil_war_hue"
      ],
      "uv_anim": {
        "offset": [
          "variable.stand_u_off",
          "variable.stand_v_off"
        ],
        "scale": [
          "variable.stand_u_sc",
          "variable.stand_v_sc"
        ]
      },
      "overlay_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": "variable.stand_base_dark"
      }
    },
    "controller.render.civil_war_sat": {
      "geometry": "Geometry.civil_war",
      "materials": [
        {
          "*": "Material.stand_color_sat"
        }
      ],
      "arrays": {
        "textures": {
          "Array.variants": [
            "Texture.civil_war_gray",
            "Texture.civil_war_vivid"
          ]
        }
      },
      "textures": [
        "Array.variants[variable.stand_sat_tex]"
      ],
      "uv_anim": {
        "offset": [
          "variable.stand_su_off",
          "variable.stand_sv_off"
        ],
        "scale": [
          "variable.stand_su_sc",
          "variable.stand_sv_sc"
        ]
      },
      "overlay_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": "variable.stand_sat_dark"
      }
    },
    "controller.render.civil_war_add": {
      "geometry": "Geometry.civil_war",
      "materials": [
        {
          "*": "Material.stand_color_add"
        }
      ],
      "arrays": {
        "textures": {
          "Array.variants": [
            "Texture.civil_war_gray",
            "Texture.civil_war_hue",
            "Texture.civil_war_vivid"
          ]
        }
      },
      "textures": [
        "Array.variants[variable.stand_add_tex]"
      ],
      "uv_anim": {
        "offset": [
          "variable.stand_bu_off",
          "variable.stand_bv_off"
        ],
        "scale": [
          "variable.stand_bu_sc",
          "variable.stand_bv_sc"
        ]
      },
      "overlay_color": {
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": "variable.stand_add_dark"
      }
    }
  }
}
