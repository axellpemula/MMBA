{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "boku:firework_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sfx/menyala"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 26
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.08
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0, 0],
        "radius": 0.12,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.30 + v.particle_random_1 * 0.20"
      },
      "minecraft:particle_initial_speed": "7.5 + v.particle_random_2 * 5.5",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -8.5, 0],
        "linear_drag_coefficient": 4.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.28 + v.particle_random_3 * 0.24) * (1 - 0.55 * (v.particle_age / v.particle_lifetime))",
          "0.055 + v.particle_random_4 * 0.035"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "t.u = v.particle_age / v.particle_lifetime; return math.lerp(1.0, v.color.x ? v.color.x : 1.0, math.min(t.u * 3.0, 1.0));",
          "t.u = v.particle_age / v.particle_lifetime; return math.lerp(0.96, v.color.y ? v.color.y : 0.6, math.min(t.u * 3.0, 1.0));",
          "t.u = v.particle_age / v.particle_lifetime; return math.lerp(0.85, v.color.z ? v.color.z : 0.15, math.min(t.u * 3.0, 1.0));",
          "math.pow(math.max(1 - (v.particle_age / v.particle_lifetime), 0), 1.3)"
        ]
      }
    }
  }
}
