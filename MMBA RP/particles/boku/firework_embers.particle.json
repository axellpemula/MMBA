{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "boku:firework_embers",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_sharp_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.08
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0, 0],
        "radius": 0.25,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.42 + v.particle_random_1 * 0.28"
      },
      "minecraft:particle_initial_speed": "3.2 + v.particle_random_2 * 3.0",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -4.8, 0],
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.12 + v.particle_random_3 * 0.08) * (1 - 0.7 * (v.particle_age / v.particle_lifetime))",
          "(0.12 + v.particle_random_3 * 0.08) * (1 - 0.7 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [64, 64]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.x ? v.color.x : 1.0",
          "v.color.y ? v.color.y : 0.72",
          "v.color.z ? v.color.z : 0.2",
          "math.pow(math.max(1 - (v.particle_age / v.particle_lifetime), 0), 1.5)"
        ]
      }
    }
  }
}
