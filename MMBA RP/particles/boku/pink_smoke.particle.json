{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "boku:pink_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sfx/asap"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.size; v.life; v.color; v.alpha; v.speed;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ? v.life : 1.1) + v.particle_random_1 * 0.35"
      },
      "minecraft:particle_initial_speed": "(v.speed ? v.speed : 0.9) * (0.65 + v.particle_random_2 * 0.7)",
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360",
        "rotation_rate": "math.random(-48, 48)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.42, 0],
        "linear_drag_coefficient": 2.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ? v.size : 1.4) * (0.75 + 0.75 * (v.particle_age / v.particle_lifetime))",
          "(v.size ? v.size : 1.4) * (0.75 + 0.75 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.x ? v.color.x : 1.0",
          "v.color.y ? v.color.y : 0.42",
          "v.color.z ? v.color.z : 0.80",
          "(v.alpha ? v.alpha : 0.58) * math.min(1.0, v.particle_age / 0.12) * math.pow(math.max(1.0 - (v.particle_age / v.particle_lifetime), 0.0), 1.35)"
        ]
      }
    }
  }
}
