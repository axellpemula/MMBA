{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:dust_puff",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sfx/asap"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.35,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.45 + variable.particle_random_1 * 0.25"
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 2.2)",
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_2 * 360",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.8, 0],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.6 + variable.particle_random_3 * 0.5) * (0.5 + 1.2 * (variable.particle_age / variable.particle_lifetime))",
          "(0.6 + variable.particle_random_3 * 0.5) * (0.5 + 1.2 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#D8E0D7CD",
            "0.35": "#B0C2B6A6",
            "0.75": "#508F8476",
            "1.0": "#0050473C"
          }
        }
      }
    }
  }
}

