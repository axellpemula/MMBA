{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:block_shield",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sfx/shield"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.25
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.25
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 0.8) * 0.9",
          "v.size ?? 0.8"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.normal.x",
            "v.normal.y",
            "v.normal.z"
          ]
        },
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.x ?? 0.3",
          "v.color.y ?? 0.85",
          "v.color.z ?? 1.0",
          "(v.alpha ?? 0.85) * (1 - math.pow(v.particle_age / 0.25, 2))"
        ]
      }
    }
  }
}