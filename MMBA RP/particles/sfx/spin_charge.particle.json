          0
        ],
        "linear_drag_coefficient": 1.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.particle_random_4 < 0.35 ? (0.8 + (v.particle_age / v.particle_lifetime) * 1.2) : (0.45 + (v.particle_age / v.particle_lifetime) * 2.1)",
          "v.particle_random_4 < 0.35 ? (0.8 + (v.particle_age / v.particle_lifetime) * 1.2) : (0.45 + (v.particle_age / v.particle_lifetime) * 2.1)"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
