            "math.sin(v.particle_random_1 * 360) * (v.particle_random_4 < 0.35 ? 0.15 : 0.32)"
          ]
        },
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "v.particle_random_4 < 0.35 ? 0.96 : (0.86 - (v.particle_age / v.particle_lifetime) * 0.16)",
          "v.particle_random_4 < 0.35 ? 0.85 : (0.28 - (v.particle_age / v.particle_lifetime) * 0.2)",
          "math.sin((v.particle_age / v.particle_lifetime) * 180) * (v.particle_random_4 < 0.35 ? 0.75 : 0.65)"
        ]
      }
    }
  }
}