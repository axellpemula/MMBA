{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:spin_charge",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sfx/impact2"
      }
    },
    "components": {
