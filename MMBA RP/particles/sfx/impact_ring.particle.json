{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:impact_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_sharp_atlas"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.time"
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [0, 0, 0]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.time"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [0, 0, 0],
        "rotation": "v.turn"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 + (v.radius - 0.3) * (1 - math.pow(1 - math.clamp(v.particle_age / v.time, 0, 1), 3))",
          "0.3 + (v.radius - 0.3) * (1 - math.pow(1 - math.clamp(v.particle_age / v.time, 0, 1), 3))"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 256,
          "texture_height": 128,
          "uv": ["v.soft > 0.5 ? 64 : 128", 0],
          "uv_size": [64, 64]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": ["v.normal.x", "v.normal.y", "v.normal.z"]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.x",
          "v.color.y",
          "v.color.z",
          "v.alpha * math.pow(1 - math.clamp(v.particle_age / v.time, 0, 1), 1.5)"
        ]
      }
    }
  }
}
