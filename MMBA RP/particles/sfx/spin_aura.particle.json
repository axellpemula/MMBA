{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:spin_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_sharp_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.38 + v.particle_random_3 * 0.18"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "t.r = 0.52 + v.particle_random_1 * 0.28; t.a = v.particle_random_2 * 360 + v.particle_age * 280; return math.cos(t.a) * t.r;",
          "0.1 + (v.particle_age / v.particle_lifetime) * 1.7",
          "t.r = 0.52 + v.particle_random_1 * 0.28; t.a = v.particle_random_2 * 360 + v.particle_age * 280; return math.sin(t.a) * t.r;"
        ],
        "direction": [
          "t.a = v.particle_random_2 * 360 + v.particle_age * 280; return -math.sin(t.a) * 0.6;",
          "0.9",
          "t.a = v.particle_random_2 * 360 + v.particle_age * 280; return math.cos(t.a) * 0.6;"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.28 + v.particle_random_1 * 0.12) * (1 - (v.particle_age / v.particle_lifetime) * 0.2)",
          "0.07 + v.particle_random_4 * 0.02"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 256,
          "texture_height": 128,
          "uv": [128, 64],
          "uv_size": [128, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          0.85,
          0.28,
          "math.sin(180 * math.min(v.particle_age / v.particle_lifetime, 1)) * 0.75"
        ]
      }
    }
  }
}
