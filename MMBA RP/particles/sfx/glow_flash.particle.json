{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:glow_flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_sharp_atlas"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life"
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [0, 0, 0]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size * 0.5 * (0.7 + 0.3 * math.clamp(v.particle_age / 0.06, 0, 1))",
          "v.size * 0.5 * (0.7 + 0.3 * math.clamp(v.particle_age / 0.06, 0, 1))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [64, 64]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.x",
          "v.color.y",
          "v.color.z",
          "v.alpha * math.pow(math.max(1 - v.particle_age / v.life, 0), 1.5)"
        ]
      }
    }
  }
}
