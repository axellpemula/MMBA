{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xvoid:blood",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/punch"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random(9, 17)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [
					0,
					0.5,
					0
				],
				"radius": 0.3,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.5, 1.5)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(2, 7)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					-15,
					0
				],
				"linear_drag_coefficient": "math.random(0.15, 0.25)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(v.particle_random_3 * 0.01 + 0.65) + (v.particle_age * 0.2)",
					"(v.particle_random_3 * 0.1 + 0.65) + (v.particle_age * 0.2)"
				],
				"facing_camera_mode": "direction_y",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.001
				},
				"uv": {
					"texture_width": 7650,
					"texture_height": 450,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							450,
							450
						],
						"step_UV": [
							450,
							0
						],
						"frames_per_second": 10,
						"max_frame": 9,
						"stretch_to_lifetime": true,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 5,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00780000",
						"0.09": "#FF610000",
						"1.0": "#00550000"
					}
				}
			}
		}
	}
}