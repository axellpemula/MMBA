{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sm:transform_ring",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/vfx_sharp_atlas"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false,
				"velocity": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 2
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, -0.9, 0],
				"direction": [0, 0, 0]
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.42 + v.particle_random_1 * 0.1"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [0, "(v.particle_age / v.particle_lifetime) * 0.18", 0],
				"rotation": "v.particle_random_2 * 360 + v.particle_age * 140"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.45 + 2.4 * (1 - math.pow(1 - math.clamp(v.particle_age / v.particle_lifetime, 0, 1), 3))",
					"0.45 + 2.4 * (1 - math.pow(1 - math.clamp(v.particle_age / v.particle_lifetime, 0, 1), 3))"
				],
				"facing_camera_mode": "direction_z",
				"uv": {
					"texture_width": 256,
					"texture_height": 128,
					"uv": ["v.particle_random_3 > 0.5 ? 64 : 128", 0],
					"uv_size": [64, 64]
				},
				"direction": {
					"mode": "custom",
					"custom_direction": [0, 1, 0]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#F2B8FFDA",
						"0.22": "#E038D6A4",
						"0.6": "#9E9EC44A",
						"1.0": "#001C5268"
					}
				}
			}
		}
	}
}

