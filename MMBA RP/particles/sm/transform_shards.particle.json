{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sm:transform_shards",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/sfx/menyala"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 26
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.6
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.0, 0],
				"radius": 0.45,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.35, 0.65)"
			},
			"minecraft:particle_initial_speed": "math.random(4.5, 9.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.random(-3, 3)",
					"math.random(1.5, 5.5)",
					"math.random(-3, 3)"
				],
				"linear_drag_coefficient": 3.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.08 + v.particle_random_1 * 0.14) * (1 - 0.65 * (v.particle_age / v.particle_lifetime))",
					"(0.24 + v.particle_random_2 * 0.34) * (1 - 0.55 * (v.particle_age / v.particle_lifetime))"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.15": "#E64AF2BC",
						"0.5": "#CC9BD452",
						"0.82": "#73236B8E",
						"1.0": "#00143A4A"
					}
				}
			}
		}
	}
}

