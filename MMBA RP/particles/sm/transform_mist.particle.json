{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sm:transform_mist",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/sbr/spin"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 36,
				"max_particles": 12
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.28
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					0,
					-1,
					0
				],
				"radius": 0.45,
				"direction": [
					"math.random(-0.35, 0.35)",
					"math.random(0.75, 1.25)",
					"math.random(-0.35, 0.35)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.24, 0.34)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "v.particle_random_1 * 360",
				"rotation_rate": "v.particle_random_2 > 0.5 ? 1080 : -1080"
			},
			"minecraft:particle_initial_speed": "math.random(1.8, 3.4)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					2.2,
					0
				],
				"linear_drag_coefficient": 2.4
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.42 + (v.particle_age / v.particle_lifetime) * 0.62",
					"0.42 + (v.particle_age / v.particle_lifetime) * 0.62"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 32,
					"flipbook": {
						"base_UV": [
							0,
							0
						],
						"size_UV": [
							32,
							32
						],
						"step_UV": [
							32,
							0
						],
						"frames_per_second": 20,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00D8FFF2",
						"0.18": "#F546DEB5",
						"0.58": "#CC9BD452",
						"1.0": "#001A5C48"
					}
				}
			}
		}
	}
}