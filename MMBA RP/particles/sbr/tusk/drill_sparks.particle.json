{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tusk:drill_sparks",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/sfx/menyala"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 52,
				"max_particles": 24
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.68
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"math.cos(v.emitter_age * 1900) * 0.14",
					"math.sin(v.emitter_age * 1900) * 0.14",
					0
				],
				"direction": [
					"math.cos(v.emitter_age * 1900 + v.particle_random_1 * 90) * 0.75",
					"math.sin(v.emitter_age * 1900 + v.particle_random_1 * 90) * 0.75",
					"math.random(-1.1, 0.3)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.14, 0.26)"
			},
			"minecraft:particle_initial_speed": "3.2 + v.particle_random_2 * 3.8",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 4.8
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.16 + v.particle_random_3 * 0.14) * (1 - 0.65 * (v.particle_age / v.particle_lifetime))",
					"0.04 + v.particle_random_4 * 0.03"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.2": "#F57DF2FF",
						"0.58": "#D91E88FF",
						"1.0": "#000033AA"
					}
				}
			}
		}
	}
}

