{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tusk:golden_ratio",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sbr/golden_ratio"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life"
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [0, 0, 0]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [0, 0, 0],
        "rotation": "v.turn + v.particle_age * v.spin"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size * (0.65 + 0.45 * math.sin(90 * math.clamp(v.particle_age / v.life, 0, 1)))",
          "v.size * (0.65 + 0.45 * math.sin(90 * math.clamp(v.particle_age / v.life, 0, 1)))"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [128, 128]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": ["v.nx", "v.ny", "v.nz"]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          0.92,
          0.42,
          "v.alpha * math.sin(180 * math.clamp(v.particle_age / v.life, 0, 1))"
        ]
      }
    }
  }
}

