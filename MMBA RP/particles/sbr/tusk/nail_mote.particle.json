{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tusk:nail_mote",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_sharp_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.size; variable.life; variable.color; variable.alpha;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "math.random(-0.5, 0.5)",
          "math.random(-0.3, 0.6)",
          "math.random(-0.5, 0.5)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life * (0.8 + v.particle_random_1 * 0.4)"
      },
      "minecraft:particle_initial_speed": "0.35 + v.particle_random_2 * 0.55",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (1 - 0.78 * math.clamp(v.particle_age / v.particle_lifetime, 0, 1))",
          "variable.size * (1 - 0.78 * math.clamp(v.particle_age / v.particle_lifetime, 0, 1))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [64, 64]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.x",
          "variable.color.y",
          "variable.color.z",
          "variable.alpha * math.pow(math.max(1 - v.particle_age / v.particle_lifetime, 0), 1.4)"
        ]
      }
    }
  }
}

