{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tusk:wormhole_spiral",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sbr/tusk_wormhole"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life"
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [0, 0, 0]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [0, 0, 0],
        "rotation": "v.turn + v.particle_age * v.spin"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.14 + (v.radius - 0.14) * math.pow(math.clamp(v.particle_age / v.life, 0, 1), 0.72)",
          "0.14 + (v.radius - 0.14) * math.pow(math.clamp(v.particle_age / v.life, 0, 1), 0.72)"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [128, 128]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": ["v.nx", "v.ny", "v.nz"]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.cr",
          "v.cg",
          "v.cb",
          "v.alpha * math.sin(180 * math.clamp(v.particle_age / v.life, 0, 1))"
        ]
      }
    }
  }
}

