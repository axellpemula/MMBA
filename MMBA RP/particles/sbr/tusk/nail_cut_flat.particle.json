{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tusk:nail_cut_flat",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_energy_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.s_x; v.s_y; v.life; v.alpha; v.color; v.roll;"
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life"
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [0, 0, 0]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_motion_parametric": {
        "rotation": "v.roll"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.s_x",
          "v.s_y * (1 - 0.65 * math.clamp(v.particle_age / math.max(v.life, 0.01), 0, 1))"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 128,
          "texture_height": 64,
          "uv": [0, 32],
          "uv_size": [128, 32]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [0, 1, 0]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color.x",
          "v.color.y",
          "v.color.z",
          "v.alpha * (1 - math.pow(math.clamp(v.particle_age / math.max(v.life, 0.01), 0, 1), 1.4))"
        ]
      }
    }
  }
}
