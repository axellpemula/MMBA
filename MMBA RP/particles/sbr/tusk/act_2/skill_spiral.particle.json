{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tusk2:skill_spiral",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/sbr/spin"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 56,
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.54
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"math.cos(v.emitter_age * 1850) * 0.16",
					"math.sin(v.emitter_age * 1850) * 0.16",
					0
				],
				"direction": [0, 0, -1]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.28
			},
			"minecraft:particle_initial_spin": {
				"rotation": "v.particle_random_1 * 360",
				"rotation_rate": 1700
			},
			"minecraft:particle_initial_speed": 2.6,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0, -5.0],
				"linear_drag_coefficient": 1.1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"1.30 - (v.particle_age / v.particle_lifetime) * 0.96",
					"1.30 - (v.particle_age / v.particle_lifetime) * 0.96"
				],
				"facing_camera_mode": "direction_z",
				"direction": {
					"mode": "custom",
					"custom_direction": [0, 0, -1]
				},
				"uv": {
					"texture_width": 128,
					"texture_height": 32,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [32, 32],
						"step_UV": [32, 0],
						"frames_per_second": 24,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFF5C0",
						"0.16": "#FFFFEE77",
						"0.5": "#EBFFAA1A",
						"0.84": "#B8E66A00",
						"1.0": "#00882200"
					}
				}
			}
		}
	}
}

