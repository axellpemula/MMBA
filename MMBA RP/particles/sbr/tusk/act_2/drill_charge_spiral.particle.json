{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tusk2:drill_charge_spiral",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/sbr/spin"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 64,
				"max_particles": 34
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.54
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"math.cos(v.emitter_age * 2400) * 0.24",
					"math.sin(v.emitter_age * 2400) * 0.24",
					0
				],
				"direction": [0, 0, -1]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.28
			},
			"minecraft:particle_initial_spin": {
				"rotation": "v.particle_random_1 * 360",
				"rotation_rate": 2160
			},
			"minecraft:particle_initial_speed": 3.0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0, -6.0],
				"linear_drag_coefficient": 1.05
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"1.45 - (v.particle_age / v.particle_lifetime) * 1.10",
					"1.45 - (v.particle_age / v.particle_lifetime) * 1.10"
				],
				"facing_camera_mode": "direction_z",
				"direction": {
					"mode": "custom",
					"custom_direction": [0, 0, -1]
				},
				"uv": {
					"texture_width": 128,
					"texture_height": 32,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [32, 32],
						"step_UV": [32, 0],
						"frames_per_second": 24,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFE4B5",
						"0.16": "#FFFFAA33",
						"0.5": "#EBFF5511",
						"0.84": "#B8B82200",
						"1.0": "#00660000"
					}
				}
			}
		}
	}
}

