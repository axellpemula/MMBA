{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tusk2:drill_burst",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/sfx/menyala"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 36
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.45
			},
			"minecraft:emitter_shape_point": {
				"direction": [
					"math.random(-1.0, 1.0)",
					"math.random(-0.8, 1.0)",
					"math.random(-1.0, 1.0)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.24, 0.42)"
			},
			"minecraft:particle_initial_speed": "7.5 + v.particle_random_2 * 9.5",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 5.0
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.30 + v.particle_random_3 * 0.25) * (1 - 0.6 * (v.particle_age / v.particle_lifetime))",
					"0.08 + v.particle_random_4 * 0.05"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.18": "#FFFFC857",
						"0.55": "#EBFF5511",
						"1.0": "#00881100"
					}
				}
			}
		}
	}
}

