{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tusk:wormhole_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/circle"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life"
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [0, 0, 0]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size * (1 - 0.55 * math.clamp(v.particle_age / math.max(v.life, 0.01), 0, 1))",
          "v.size * (1 - 0.55 * math.clamp(v.particle_age / math.max(v.life, 0.01), 0, 1))"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [0, 0],
          "uv_size": [32, 32]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": ["v.nx", "v.ny", "v.nz"]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.01,
          0.01,
          0.02,
          "v.alpha * (1 - math.pow(math.clamp(v.particle_age / math.max(v.life, 0.01), 0, 1), 1.4))"
        ]
      }
    }
  }
}
