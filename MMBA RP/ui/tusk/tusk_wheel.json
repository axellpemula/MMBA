{
  "namespace": "tusk_wheel",
  "dpad_bg_variant": {
    "type": "image",
    "size": [
      "100%",
      "100%"
    ],
    "texture": "$tile_texture",
    "color": "$variant_color",
    "alpha": "$variant_alpha",
    "layer": 1,
    "$variant_marker|default": "§u§r",
    "$variant_color|default": [
      0.78,
      0.70,
      0.92
    ],
    "$variant_alpha|default": 0.95,
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "form_buttons",
        "binding_name": "#form_button_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - $variant_marker) = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "dpad_tile_visual": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$tile_texture|default": "textures/ui/stand_ui/button_default",
    "$tile_offset|default": [
      0,
      0
    ],
    "$unlocked_color|default": [
      0.80,
      0.72,
      0.95
    ],
    "$active_color|default": [
      0.56,
      0.95,
      0.68
    ],
    "$locked_color|default": [
      0.42,
      0.40,
      0.48
    ],
    "$exit_color|default": [
      0.92,
      0.36,
      0.42
    ],
    "controls": [
      {
        "bg_unlocked@tusk_wheel.dpad_bg_variant": {
          "$variant_marker": "§u§r",
          "$variant_color": "$unlocked_color"
        }
      },
      {
        "bg_active@tusk_wheel.dpad_bg_variant": {
          "$variant_marker": "§s§r",
          "$variant_color": "$active_color"
        }
      },
      {
        "bg_locked@tusk_wheel.dpad_bg_variant": {
          "$variant_marker": "§l§r",
          "$variant_color": "$locked_color",
          "$variant_alpha": 0.85
        }
      },
      {
        "bg_exit@tusk_wheel.dpad_bg_variant": {
          "$variant_marker": "§x§r",
          "$variant_color": "$exit_color"
        }
      },
      {
        "tile_content": {
          "type": "panel",
          "size": [
            "100% - 6px",
            "100% - 6px"
          ],
          "offset": "$tile_offset",
          "layer": 4,
          "controls": [
            {
              "tile_icon": {
                "type": "image",
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [
                  0,
                  12
                ],
                "size": [
                  32,
                  32
                ],
                "keep_ratio": true,
                "bilinear": false,
                "layer": 5,
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_texture"
                  },
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture"
                  },
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not (#form_button_texture = ''))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "tile_label": {
                "type": "label",
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [
                  0,
                  -4
                ],
                "size": [
                  "100%",
                  "default"
                ],
                "text": "#form_button_text",
                "text_alignment": "center",
                "font_scale_factor": 0.74,
                "shadow": true,
                "color": [
                  1.0,
                  1.0,
                  1.0
                ],
                "layer": 6,
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_text"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "dpad_tile_default@tusk_wheel.dpad_tile_visual": {},
  "dpad_tile_hover@tusk_wheel.dpad_tile_visual": {
    "$tile_texture": "textures/ui/stand_ui/button_hover",
    "$tile_offset": [
      0,
      -1
    ],
    "$unlocked_color": [
      0.96,
      0.86,
      1.0
    ],
    "$active_color": [
      0.72,
      1.0,
      0.80
    ],
    "$locked_color": [
      0.56,
      0.52,
      0.62
    ],
    "$exit_color": [
      1.0,
      0.50,
      0.56
    ]
  },
  "dpad_tile_pressed@tusk_wheel.dpad_tile_visual": {
    "$tile_texture": "textures/ui/stand_ui/button_pressed",
    "$tile_offset": [
      0,
      1
    ],
    "$unlocked_color": [
      0.72,
      0.64,
      0.86
    ],
    "$active_color": [
      0.48,
      0.84,
      0.58
    ],
    "$locked_color": [
      0.36,
      0.34,
      0.42
    ],
    "$exit_color": [
      0.82,
      0.28,
      0.34
    ]
  },
  "dpad_grid_cell": {
    "type": "panel",
    "size": [
      78,
      78
    ],
    "controls": [
      {
        "dpad_cell_content": {
          "type": "panel",
          "size": [
            72,
            72
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#form_button_text - '§0§r') = #form_button_text)",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "dpad_btn@common.button": {
                "size": [
                  "100%",
                  "100%"
                ],
                "$pressed_button_name": "button.form_button_click",
                "sound_name": "random.click",
                "sound_volume": 0.8,
                "sound_pitch": 1.0,
                "default_control": "default",
                "hover_control": "hover",
                "pressed_control": "pressed",
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name": "#form_button_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#form_button_text - '§0§r') = #form_button_text)",
                    "target_property_name": "#enabled"
                  }
                ],
                "controls": [
                  {
                    "default@tusk_wheel.dpad_tile_default": {}
                  },
                  {
                    "hover@tusk_wheel.dpad_tile_hover": {}
                  },
                  {
                    "pressed@tusk_wheel.dpad_tile_pressed": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "tusk_wheel_root": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "backdrop_scrim": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [
            0.03,
            0.02,
            0.06
          ],
          "alpha": 0.45,
          "size": [
            "100%",
            "100%"
          ],
          "layer": 1
        }
      },
      {
        "dpad_canvas": {
          "type": "panel",
          "size": [
            234,
            234
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 10,
          "controls": [
            {
              "dpad_grid": {
                "type": "grid",
                "size": [
                  234,
                  234
                ],
                "anchor_from": "center",
                "anchor_to": "center",
                "grid_dimensions": [
                  3,
                  3
                ],
                "grid_item_template": "tusk_wheel.dpad_grid_cell",
                "collection_name": "form_buttons",
                "bindings": [
                  {
                    "binding_name": "#form_button_length",
                    "binding_name_override": "#maximum_grid_items"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "wheel_footer_hint": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [
            0,
            -14
          ],
          "text": "Select an Act",
          "color": [
            0.84,
            0.80,
            0.92
          ],
          "shadow": true,
          "font_scale_factor": 0.88,
          "layer": 15
        }
      }
    ]
  }
}