        "binding_type": "view",
        "source_property_name": "((((((#hud_title_text_string - '_mmba:') = #hud_title_text_string) and (not (#hud_title_text_string = 'king_crimson'))) and (not (#hud_title_text_string = 'ataxia'))) and ((not (#hud_title_text_string = 'contoh_title')) and (not (#hud_title_text_string = 'energy_hide')))) and ((((#hud_title_text_string - 'energy:') = #hud_title_text_string) and ((#hud_title_text_string - 'tusk:') = #hud_title_text_string)) and (((#hud_title_text_string - 'ts_') = #hud_title_text_string) and ((#hud_title_text_string - 'sm_dino') = #hud_title_text_string))))",
