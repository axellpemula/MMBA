{
  "namespace": "stand_color_common",
  "dialog_bg": {
    "type": "image",
    "texture": "textures/ui/stand_ui/dialog_background"
  },
  "dialog_title_bg": {
    "type": "image",
    "texture": "textures/ui/stand_ui/dialog_title_background"
  },
  "paperdoll_card_bg": {
    "type": "image",
    "texture": "textures/ui/stand_ui/paperdoll_card"
  },
  "controls_card_bg": {
    "type": "image",
    "texture": "textures/ui/stand_ui/controls_card"
  },
  "divider": {
    "type": "image",
    "texture": "textures/ui/stand_ui/divider",
    "size": [
      "100%",
      2
    ]
  },
  "padding": {
    "type": "panel",
    "$padding|default": [
      0,
      0
    ],
    "size": "$padding"
  },
  "scrollbar_handle": {
    "type": "image",
    "texture": "textures/ui/stand_ui/scroll_handle"
  },
  "scrollbar_track": {
    "type": "image",
    "texture": "textures/ui/stand_ui/scroll_track"
  },
  "default_scrollbar@common.scrolling_panel": {
    "$scroll_box_touch_image_control": "stand_color_common.scrollbar_handle",
    "$scroll_box_mouse_image_control": "stand_color_common.scrollbar_handle",
    "$scroll_track_image_control": "stand_color_common.scrollbar_track",
    "$scroll_size": [
      4,
      "100%"
    ]
  },
  "button_label": {
    "type": "label",
    "text": "$button_text",
    "text_alignment": "center",
    "layer": 10,
    "$button_label_collection|default": "custom_form",
    "$button_label_binding_type|default": "global",
    "size": [
      "100% - 6px",
      "default"
    ],
    "max_size": [
      "100% - 6px",
      "100% - 4px"
    ],
    "color": [
      0.98,
      0.95,
      0.88
    ],
    "shadow": true,
    "bindings": [
      {
        "binding_name": "$button_text",
        "binding_type": "$button_label_binding_type"
      }
    ]
  },
  "stand_button_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "$button_content_size|default": [
      "100% - 6px",
      "100% - 4px"
    ],
    "$button_content|default": "common.empty_panel",
    "$button_content_offset|default": [
      0,
      0
    ],
    "controls": [
      {
        "button_image": {
          "type": "image",
          "texture": "$button_texture",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "button_content_panel": {
          "type": "panel",
          "size": "$button_content_size",
          "offset": "$button_content_offset",
          "controls": [
            {
              "button_content@$button_content": {}
            }
          ]
        }
      }
    ]
  },
  "stand_button@common.button": {
    "$button_panel": "stand_color_common.stand_button_panel",
    "$default_texture|default": "textures/ui/stand_ui/button_default",
    "$hover_texture|default": "textures/ui/stand_ui/button_hover",
    "$pressed_texture|default": "textures/ui/stand_ui/button_pressed",
    "$default_content_offset|default": [
      0,
      -1
    ],
    "$hover_content_offset|default": [
      0,
      -1
    ],
    "$pressed_content_offset|default": [
      0,
      0
    ],
    "controls": [
      {
        "default@$button_panel": {
          "$button_texture": "$default_texture",
          "$button_content_offset": "$default_content_offset"
        }
      },
      {
        "hover@$button_panel": {
          "$button_texture": "$hover_texture",
          "$button_content_offset": "$hover_content_offset"
        }
      },
      {
        "pressed@$button_panel": {
          "$button_texture": "$pressed_texture",
          "$button_content_offset": "$pressed_content_offset"
        }
      }
    ]
  },
  "close_icon": {
    "type": "image",
    "texture": "textures/ui/stand_ui/close_icon",
    "size": [
      14,
      14
    ],
    "color": [
      0.98,
      0.95,
      0.90
    ]
  },
  "stand_close_button@stand_color_common.stand_button": {
    "$pressed_button_name": "button.menu_exit",
    "$button_content": "stand_color_common.close_icon",
    "$default_content_offset": [
      0,
      0
    ],
    "$hover_content_offset": [
      0,
      0
    ],
    "$pressed_content_offset": [
      0,
      1
    ]
  },
  "stand_dialog_title_text": {
    "type": "label",
    "text": "#text",
    "color": [
      0.98,
      0.90,
      0.66
    ],
    "shadow": true,
    "size": [
      "default",
      "default"
    ],
    "max_size": [
      "100% - 16px",
      "100% - 4px"
    ],
    "offset": [
      0,
      -1
    ],
    "font_type": "MinecraftTen",
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - $stand_color_form_tag)",
        "target_property_name": "#text"
      }
    ]
  },
  "stand_dialog_form": {
    "type": "stack_panel",
    "size": "$stand_color_form_size",
    "max_size": "$stand_color_form_size",
    "anchor_from": "center",
    "anchor_to": "center",
    "$dialog_content|default": "common.empty_panel",
    "controls": [
      {
        "dialog_title_panel": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [
            "100%",
            24
          ],
          "controls": [
            {
              "dialog_title@stand_color_common.dialog_title_bg": {
                "size": [
                  "fill",
                  "100%"
                ],
                "controls": [
                  {
                    "title_text@stand_color_common.stand_dialog_title_text": {}
                  }
                ]
              }
            },
            {
              "title_gap@stand_color_common.padding": {
                "$padding": [
                  3,
                  "100%"
                ]
              }
            },
            {
              "close_button@stand_color_common.stand_close_button": {
                "size": [
                  "100%y",
                  "100%"
                ]
              }
            }
          ]
        }
      },
      {
        "header_gap@stand_color_common.padding": {
          "$padding": [
            "100%",
            3
          ]
        }
      },
      {
        "dialog_main@stand_color_common.dialog_bg": {
          "size": [
            "100%",
            "fill"
          ],
          "controls": [
            {
              "content_panel": {
                "type": "panel",
                "size": [
                  "100% - 14px",
                  "100% - 14px"
                ],
                "controls": [
                  {
                    "content@$dialog_content": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}

